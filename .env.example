# Admin Credentials
ADMIN_PASSWORD=your_secure_password_here

# Supabase Configuration
# Get these from your Supabase project settings (Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Note: Create a public bucket named 'portfolio' in Supabase Storage

# Email Configuration (for Contact Form)
# If using Gmail, use an App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
